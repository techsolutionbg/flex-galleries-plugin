{
  "id": "flex/galleries",
  "name": "Flex Galleries",
  "version": "0.2.0",
  "description": "Галерии с решетка, masonry, слайдер и lightbox. Множество галерии на страница.",
  "minimum_platform_version": "0.1.62",
  "entrypoint": "Flex\\Galleries\\GalleryPlugin",
  "autoload": {
    "Flex\\Galleries\\": "src/"
  },
  "permissions": [
    "admin.ui",
    "routes.admin",
    "frontend.assets"
  ],
  "frontend": {
    "scripts": [
      "assets/admin.js",
      "assets/galleries.js"
    ],
    "styles": [
      "assets/galleries.css"
    ],
    "public": {
      "groups": {
        "gallery": {
          "scripts": [
            "assets/galleries.js"
          ],
          "styles": [
            "assets/galleries.css"
          ]
        }
      }
    }
  },
  "metadata": {
    "status": "stable",
    "storage": "database"
  }
}
